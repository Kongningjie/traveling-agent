# 复制为 .env，并替换这两个仅用于示例的密码；不要提交 .env。
POSTGRES_DB=traveling_agent
POSTGRES_USER=traveling_agent
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_PORT=6379
BACKEND_PORT=8080
WEB_PORT=8088
DASHSCOPE_API_KEY=
AMAP_API_KEY=
TAVILY_API_KEY=

# 本机runner认证，仅本地.env设置随机秘密；镜像由构建脚本固定为sha256 ID。
DOCUMENT_PARSER_SECRET=
DOCUMENT_PARSER_IMAGE=
# 可选收紧附件配置；默认：单份10MiB／100页／20万字符／展开50MiB／60秒，聊天10份、用户200MiB／100万字符。
# DOCUMENT_MAX_BYTES=10485760
# DOCUMENT_MAX_PAGES=100
# DOCUMENT_MAX_TEXT=200000
# DOCUMENT_MAX_EXPANDED=52428800
# DOCUMENT_MAX_SECONDS=60
# DOCUMENT_MAX_PER_CHAT=10
# DOCUMENT_MAX_USER_BYTES=209715200
# DOCUMENT_MAX_USER_TEXT=1000000
